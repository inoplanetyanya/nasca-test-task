# Параметры инфраструктуры Docker
HOST_PORT=5000
CONTAINER_PORT=5000
IMAGE_NAME=simple-app
IMAGE_TAG=latest
CONTAINER_NAME=simple_app_container

# Конфигурация приложения
APP_ENV=production
PYTHONUNBUFFERED=1

# Пути для Ansible на целевом сервере
DEPLOY_DIR=/opt/simple-app

# Конфигурация Ansible
PLAYBOOK=ansible/playbook.yml
INVENTORY=ansible/inventory.ini
